#:kivy 2.0
#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

# All sizes use dp/sp so the app looks the same on every screen density
# and follows the system font-size setting.

<FlatButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: (1, 1, 1, 0.28) if self.state == "down" else (1, 1, 1, 0.14)
    color: app.fg_color
    font_name: app.font_name_value
    font_size: sp(15)

<Background@BoxLayout>:
    canvas.before:
        Color:
            rgba: app.bg_color
        Rectangle:
            pos: self.pos
            size: self.size

<SettingLabel@Label>:
    color: app.fg_color
    font_name: app.font_name_value
    font_size: sp(16)
    size_hint_y: None
    height: dp(36)
    text_size: self.size
    halign: "left"
    valign: "bottom"

<BookRow>:
    size_hint_y: None
    height: dp(88)
    spacing: dp(8)
    FlatButton:
        text: root.title
        font_size: sp(17)
        halign: "left"
        valign: "middle"
        text_size: self.width - dp(28), self.height
        max_lines: 2
        on_release: app.open_book_by_id(root.book_id)
    Label:
        text: root.progress_text
        color: app.accent_color
        font_name: app.font_name_value
        font_size: sp(15)
        size_hint_x: None
        width: dp(58)
    FlatButton:
        text: "X"
        size_hint_x: None
        width: dp(52)
        on_release: app.confirm_remove_book(root.book_id)

<ThemeButton>:
    background_normal: ""
    background_down: ""
    font_name: app.font_name_value
    font_size: sp(16)
    bold: self.selected
    size_hint_y: None
    height: dp(54)
    canvas.after:
        Color:
            rgba: self.color[0], self.color[1], self.color[2], (1 if self.selected else 0.3)
        Line:
            rectangle: self.x + dp(1), self.y + dp(1), self.width - dp(2), self.height - dp(2)
            width: dp(2) if self.selected else dp(1)


<LibraryScreen>:
    Background:
        orientation: "vertical"

        Label:
            text: "ChunkReader"
            font_name: app.font_name_value
            font_size: sp(22)
            bold: True
            color: app.fg_color
            size_hint_y: None
            height: dp(56)
            padding: dp(14), 0
            text_size: self.size
            halign: "left"
            valign: "middle"

        BoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: dp(12), dp(4)
            spacing: dp(8)
            FlatButton:
                text: "+ Add book"
                font_size: sp(17)
                on_release: app.prompt_add_book()
            FlatButton:
                text: "Settings"
                font_size: sp(17)
                on_release: app.go_to_settings()

        ScrollView:
            do_scroll_x: False
            BoxLayout:
                id: book_list
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(8)
                padding: dp(12)


<ReaderScreen>:
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Color:
                rgba: (0, 0, 0, 1) if app.game_mode else app.bg_color
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: dp(10), dp(8)
            spacing: dp(8)
            FlatButton:
                text: "< Books"
                size_hint_x: None
                width: dp(92)
                on_release: app.go_to_library()
            Label:
                id: book_title_label
                font_name: app.font_name_value
                font_size: sp(14)
                color: app.fg_color
                text_size: self.size
                halign: "center"
                valign: "middle"
                shorten: True
                shorten_from: "right"
            FlatButton:
                text: "Settings"
                size_hint_x: None
                width: dp(96)
                on_release: app.go_to_settings()

        # A few lines of text at a time. The box and the text are sized
        # and placed by the app (see update_reader_view in main.py).
        ReaderArea:
            id: reader_area
            on_size: app.on_reader_resized()
            on_pos: app.on_reader_resized()

            # Game mode: blue gradient window, white border, white letters.
            Widget:
                id: rpg_box
                size_hint: None, None
                opacity: 1 if app.game_mode else 0
                canvas:
                    Color:
                        rgba: 1, 1, 1, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(12)]
                    Color:
                        rgba: 0.03, 0.04, 0.18, 1
                    RoundedRectangle:
                        pos: self.x + dp(4), self.y + dp(4)
                        size: self.width - dp(8), self.height - dp(8)
                        radius: [dp(9)]
                    Color:
                        rgba: 1, 1, 1, 1
                    RoundedRectangle:
                        texture: app.rpg_texture
                        pos: self.x + dp(6), self.y + dp(6)
                        size: self.width - dp(12), self.height - dp(12)
                        radius: [dp(7)]
                    # "more text" marker, bottom right, blinking slowly
                    Color:
                        rgba: 1, 1, 1, app.rpg_cursor_alpha
                    Triangle:
                        points: self.right - dp(30), self.y + dp(20), self.right - dp(14), self.y + dp(20), self.right - dp(22), self.y + dp(11)

            Label:
                id: chunk_label
                markup: True
                size_hint: None, None
                font_name: app.font_name_value
                line_height: app.line_spacing_value
                color: (1, 1, 1, 1) if app.game_mode else app.fg_color

        # Drag the bar to move through the book; "Chapters" lists the headings.
        BoxLayout:
            size_hint_y: None
            height: dp(56)
            padding: dp(10), dp(4)
            spacing: dp(6)
            FlatButton:
                text: "Chapters"
                size_hint_x: None
                width: dp(104)
                on_release: app.open_chapters()
            Slider:
                id: progress_slider
                min: 0
                max: 1
                value: 0
                cursor_size: dp(26), dp(26)
                value_track: True
                value_track_color: app.accent_color
                on_value: app.on_slider_moved(self.value)
                on_touch_up: if args[1].grab_current is self: app.on_slider_released(self.value)
            Label:
                id: progress_label
                font_name: app.font_name_value
                font_size: sp(14)
                color: app.accent_color
                size_hint_x: None
                width: dp(48)

        Label:
            text: "next: swipe, or tap right      back: tap left"
            font_name: app.font_name_value
            font_size: sp(12)
            color: app.fg_color
            opacity: 0.55
            size_hint_y: None
            height: dp(26)


<ChapterButton>:
    markup: True
    background_normal: ""
    background_down: ""
    background_color: (1, 1, 1, 0.3) if self.state == "down" else ((1, 1, 1, 0.22) if self.current else (1, 1, 1, 0.1))
    color: app.fg_color
    bold: self.current
    font_name: app.font_name_value
    font_size: sp(16)
    halign: "left"
    valign: "middle"
    padding: dp(14), dp(10)
    size_hint_y: None
    text_size: self.width, None
    height: max(dp(56), self.texture_size[1])
    canvas.after:
        Color:
            rgba: app.accent_color[0], app.accent_color[1], app.accent_color[2], (1 if self.current else 0)
        Rectangle:
            pos: self.x, self.y
            size: dp(5), self.height


<ChaptersScreen>:
    Background:
        orientation: "vertical"

        BoxLayout:
            size_hint_y: None
            height: dp(68)
            padding: dp(12), dp(10)
            spacing: dp(8)
            FlatButton:
                text: "< Back"
                size_hint_x: None
                width: dp(100)
                on_release: app.back_to_reader()
            Label:
                text: "Chapters"
                font_name: app.font_name_value
                font_size: sp(21)
                bold: True
                color: app.fg_color
                text_size: self.size
                halign: "left"
                valign: "middle"

        ScrollView:
            id: chapter_scroll
            do_scroll_x: False
            BoxLayout:
                id: chapter_list
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(6)
                padding: dp(12)


<SettingsScreen>:
    Background:
        orientation: "vertical"

        BoxLayout:
            size_hint_y: None
            height: dp(68)
            padding: dp(12), dp(10)
            spacing: dp(8)
            FlatButton:
                text: "< Back"
                size_hint_x: None
                width: dp(100)
                on_release: app.go_back_from_settings()
            Label:
                text: "Settings"
                font_name: app.font_name_value
                font_size: sp(21)
                bold: True
                color: app.fg_color
                text_size: self.size
                halign: "left"
                valign: "middle"

        ScrollView:
            do_scroll_x: False
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: dp(16), dp(4), dp(16), dp(24)
                spacing: dp(6)

                SettingLabel:
                    text: "Lines of text at a time"
                BoxLayout:
                    id: chunk_size_row
                    size_hint_y: None
                    height: dp(56)
                    spacing: dp(8)
                    FlatButton:
                        text: "2"
                        font_size: sp(20)
                        bold: True
                        background_color: app.fg_color if app.lines_per_page == 2 else (1, 1, 1, 0.14)
                        color: app.bg_color if app.lines_per_page == 2 else app.fg_color
                        on_release: app.set_lines_per_page(2)
                    FlatButton:
                        text: "3"
                        font_size: sp(20)
                        bold: True
                        background_color: app.fg_color if app.lines_per_page == 3 else (1, 1, 1, 0.14)
                        color: app.bg_color if app.lines_per_page == 3 else app.fg_color
                        on_release: app.set_lines_per_page(3)
                    FlatButton:
                        text: "5"
                        font_size: sp(20)
                        bold: True
                        background_color: app.fg_color if app.lines_per_page == 5 else (1, 1, 1, 0.14)
                        color: app.bg_color if app.lines_per_page == 5 else app.fg_color
                        on_release: app.set_lines_per_page(5)

                SettingLabel:
                    text: "Text size: %d" % int(font_slider.value)
                Slider:
                    id: font_slider
                    min: 16
                    max: 48
                    step: 1
                    value: app.font_size_value
                    size_hint_y: None
                    height: dp(48)
                    on_value: app.set_font_size(self.value)

                SettingLabel:
                    text: "Line spacing: %.1f" % spacing_slider.value
                Slider:
                    id: spacing_slider
                    min: 1.0
                    max: 2.2
                    step: 0.1
                    value: app.line_spacing_value
                    size_hint_y: None
                    height: dp(48)
                    on_value: app.set_line_spacing(self.value)

                Label:
                    id: sample_label
                    text: "This is how the text in your book will look."
                    font_name: app.font_name_value
                    font_size: sp(app.font_size_value)
                    line_height: app.line_spacing_value
                    color: app.fg_color
                    size_hint_y: None
                    text_size: self.width, None
                    height: self.texture_size[1] + dp(20)
                    halign: "left"
                    valign: "middle"

                SettingLabel:
                    text: "Game mode (blue text box, like a 16-bit RPG)"
                FlatButton:
                    text: "Game mode: ON" if app.game_mode else "Game mode: OFF"
                    font_size: sp(17)
                    bold: app.game_mode
                    size_hint_y: None
                    height: dp(54)
                    on_release: app.toggle_game_mode()

                SettingLabel:
                    text: "Colours (when game mode is off)"
                BoxLayout:
                    id: theme_list
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(8)

                Label:
                    text: app.version_text
                    font_size: sp(12)
                    color: app.fg_color
                    opacity: 0.55
                    size_hint_y: None
                    height: dp(44)
